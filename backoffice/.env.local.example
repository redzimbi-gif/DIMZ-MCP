# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète : jamais exposée au navigateur, jamais commit
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Emails (resend.com > API Keys)
RESEND_API_KEY=re_...
# Adresse d'expédition. Tant qu'aucun domaine n'est vérifié sur Resend,
# laisse "DIMZ - Mon Copilote Auto <onboarding@resend.dev>" (envoi limité à
# ton propre email de compte Resend). Une fois un domaine vérifié :
# "DIMZ - Mon Copilote Auto <contact@ton-domaine.fr>"
EMAIL_FROM=DIMZ - Mon Copilote Auto <onboarding@resend.dev>
# URL publique du back-office, utilisée pour les liens "Suivre mon dossier"
# dans les emails. Mets l'URL Vercel une fois déployé.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notifications push sur téléphone (nouvelle demande, message client, paiement
# reçu...), via ntfy.sh — gratuit, sans compte. Installer l'appli ntfy
# (iOS/Android) et s'abonner au topic exact que tu choisis ici.
#
# ⚠️ Le nom du topic EST le mot de passe : ntfy.sh n'a aucune authentification,
# quiconque le connaît peut lire toutes tes notifications ou t'en envoyer de
# fausses. Ne jamais committer la vraie valeur — ce dépôt est public. Génère un
# nom long et aléatoire, et garde-le uniquement dans les variables
# d'environnement Vercel et dans les secrets Supabase (les Edge Functions en
# ont besoin aussi, elles ne lisent pas ce fichier) :
#   npx supabase secrets set --project-ref TON-PROJET NTFY_TOPIC=...
NTFY_TOPIC=dimz-REMPLACE-MOI-par-une-valeur-longue-et-aleatoire

# Paiement en ligne des factures (stripe.com > Développeurs > Clés API)
STRIPE_SECRET_KEY=sk_test_...
# Créée sur stripe.com > Développeurs > Webhooks, une fois l'URL de
# déploiement connue (endpoint /api/stripe/webhook, événement
# checkout.session.completed).
STRIPE_WEBHOOK_SECRET=whsec_...
