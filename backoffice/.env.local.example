# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète : jamais exposée au navigateur, jamais commit
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Emails (resend.com > API Keys)
RESEND_API_KEY=re_...
# Adresse d'expédition. Tant qu'aucun domaine n'est vérifié sur Resend,
# laisse "DIMZ - Mon Copilote Auto <onboarding@resend.dev>" (envoi limité à
# ton propre email de compte Resend). Une fois un domaine vérifié :
# "DIMZ - Mon Copilote Auto <contact@ton-domaine.fr>"
EMAIL_FROM=DIMZ - Mon Copilote Auto <onboarding@resend.dev>
# URL publique du back-office, utilisée pour les liens "Suivre mon dossier"
# dans les emails. Mets l'URL Vercel une fois déployé.
NEXT_PUBLIC_APP_URL=http://localhost:3000
